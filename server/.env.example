# ==============================================================================
# ClassMate — Server Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env for local development or configure these variables
# directly in your Cloud Host Dashboard (e.g., Render, Railway, AWS).
#
# IMPORTANT: Never commit your real .env file or production credentials to Git!
# ==============================================================================

# Application Environment ('production' for online deployment, 'development' for local)
NODE_ENV=development

# Web Server Port (Render automatically sets and manages this in production)
PORT=5000

# MongoDB Database Connection String
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/attendance_db
#
# Cloud MongoDB Atlas (Recommended for Online Deployment):
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/attendance_db?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random 256-bit / 64-character hex key)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# JWT Token Expiration Period (e.g. 7d, 24h)
JWT_EXPIRE=7d

# CORS Allowed Origins
# Leave empty or set to '*' for unified single-port deployment or development.
# In production with a custom frontend domain, specify the exact domain:
# CORS_ORIGIN=https://your-custom-domain.com
CORS_ORIGIN=*
